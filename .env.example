# Copy to .env and fill in real values. Never commit the real .env.
DB_URL=jdbc:postgresql://localhost:5432/prisma
DB_USER=prisma
DB_PASSWORD=change-me

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Generate with: openssl rand -base64 64
JWT_SECRET=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

SPRING_PROFILES_ACTIVE=dev

# --- Only for the full stack (docker-compose.full.yml) — optional ---
# APP_PORT=8080            # port the browser uses; Google redirect URI is http://localhost:<APP_PORT>/login/oauth2/code/google
# FRONTEND_DIR=../frontend # where the PrismaFront clone lives, relative to this folder
# DB_NAME=prisma
# COOKIE_SECURE=false      # true only behind HTTPS
